@model lab09.Models.TvcMember
@{ViewData["Title"]="Sửa thông tin thành viên";}
<div class="card p-4 shadow-sm"><h1 class="h3">@ViewData["Title"]</h1><hr/><form asp-action="TvcEdit" method="post"><input asp-for="TvcMemberId" type="hidden"/><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label asp-for="TvcUserName"></label><input asp-for="TvcUserName" class="form-control"/><span asp-validation-for="TvcUserName" class="text-danger"></span></div><div class="mb-3"><label asp-for="TvcPassword"></label><input asp-for="TvcPassword" class="form-control"/><span asp-validation-for="TvcPassword" class="text-danger"></span></div><div class="mb-3"><label asp-for="TvcFullName"></label><input asp-for="TvcFullName" class="form-control"/><span asp-validation-for="TvcFullName" class="text-danger"></span></div><div class="mb-3"><label asp-for="TvcEmail"></label><input asp-for="TvcEmail" class="form-control"/><span asp-validation-for="TvcEmail" class="text-danger"></span></div><button class="btn btn-primary">Cập nhật</button> <a asp-action="Index" class="btn btn-secondary">Quay lại</a></form></div>
@section Scripts{<partial name="_ValidationScriptsPartial"/>}
